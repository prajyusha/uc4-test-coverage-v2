{
  "name": "little-goods-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:server": "vitest run --coverage",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "node utils/run-browser-tests.js",
    "coverage:merge": "node utils/merge-coverage.js",
    "test:coverage": "npm run test:server && npm run test:e2e && npm run coverage:merge"
  },
  "dependencies": {
    "express": "4.22.3",
    "helmet": "8.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitest/coverage-istanbul": "3.2.7",
    "monocart-coverage-reports": "2.12.1",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "test-exclude": "7.0.1"
  }
}
